<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация</title>
    <link href="../node_modules/bootstrap/package.json" rel="stylesheet">
</head>

<body>

    <header class="p-3">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <a href="/" class="btn btn-outline-light me-2">Главная</a>
            </div>
        </div>
    </header>

    <div class="auth-container">
        <div class="auth-box">
            <h1 class="auth-title">Регистрация</h1>

            <div class="auth-tabs">
                <a href="/login" class="auth-tab">Вход</a>
                <button class="auth-tab active">Регистрация</button>
            </div>

            <form action="/register" method="POST" class="auth-form">
                <div class="form-group">
                    <input type="text" class="form-input" id="username" name="username" placeholder="E-mail" required>
                </div>

                <div class="form-group">
                    <input type="password" class="form-input" id="password" name="password" placeholder="Пароль"
                        required>
                </div>

                <button type="submit" class="auth-button">Зарегистрироваться</button>

                <div class="auth-links">
                    <p class="auth-link2">Уже есть аккаунт? <a href="/login" class="auth-link">Войдите</a></p>
                </div>
            </form>
        </div>
    </div>

</body>

</html>